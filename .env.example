# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# 32+ random chars; encrypts Google refresh tokens at rest. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Google OAuth client (Google Cloud -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ---
# Which AI drafts rubrics, rechecks scores and writes evidence: openai or claude
# (if unset: Claude when ANTHROPIC_API_KEY is set, otherwise OpenAI)
# AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# Optional cheaper model for stage 1 (every applicant, form answers only), e.g. gpt-5-mini.
# Rubric drafting and stage 2 (CV + portfolio + GitHub) use OPENAI_MODEL.
# OPENAI_SCREEN_MODEL=
# CLAUDE_SCREEN_MODEL=
# Optional: raises GitHub's API limit for stage 2 from 60 to 5,000 requests/hour
# GITHUB_TOKEN=
ANTHROPIC_API_KEY=
# Only if your key isn't created inside a workspace (Console -> Workspaces -> copy the ID, e.g. wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=
# CLAUDE_MODEL=claude-opus-5
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
