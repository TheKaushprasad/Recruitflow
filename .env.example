# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# 32+ random chars; encrypts Google refresh tokens at rest. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Google OAuth client (Google Cloud -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
