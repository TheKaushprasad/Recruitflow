# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# 32+ random chars; encrypts Google refresh tokens at rest. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Google OAuth client (Google Cloud -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (OpenAI drafts both rubric stages, decides stage-1 items Jev is unsure about, runs the stage-2 CV review) ---
OPENAI_API_KEY=
# Stage 2 CV review + rubric drafting
OPENAI_MODEL=gpt-5.4
# Stage 1 (every applicant, form answers only)
OPENAI_SCREEN_MODEL=gpt-5.4-mini
# Reasoning effort (minimal | low | medium | high). Stage 1 defaults to low; stage 2 uses the model default.
# OPENAI_SCREEN_EFFORT=low
# OPENAI_EFFORT=
# Optional: raises GitHub's API limit for stage 2 from 60 to 5,000 requests/hour
# GITHUB_TOKEN=
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
